generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Company {
  id          String      @id @default(uuid())
  companyName String      @unique
  createdAt   DateTime    @default(now())
  recipients  Recipient[]

  @@index([companyName])
}

model Recipient {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  isAlumni  Boolean
  company   Company    @relation(fields: [companyId], references: [id])
  companyId String
  emailLogs EmailLog[]

  @@index([email])
}

model EmailLog {
  id                String    @id @default(uuid())
  sentAt            DateTime  @default(now())
  recipient         Recipient @relation(fields: [recipientId], references: [id])
  recipientId       String
  status            String    @default("PENDING")
  jobPosition       String
  errorMessage      String?
  templateUsed      String?
  isMarkedWrong     Boolean   @default(false)
  markedAt          DateTime?
  notes             String?
  responseReceived  Boolean   @default(false)
  responseDate      DateTime?
  responseType      String?
  followUpScheduled DateTime?
  followUpCount     Int       @default(0)
  lastFollowUpDate  DateTime?
}

model ScheduledEmail {
  id              String    @id @default(uuid())
  email           String
  name            String
  company         String
  jobPosition     String
  isAlum          Boolean   @default(false)
  isRecruiter     Boolean   @default(false)
  tenureYears     String?
  personalMention String?
  scheduledFor    DateTime
  status          String    @default("SCHEDULED")
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
  errorMessage    String?

  @@index([scheduledFor, status])
  @@index([status])
}
