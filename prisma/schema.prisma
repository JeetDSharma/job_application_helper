generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Company {
  id          String      @id @default(uuid())
  companyName String      @unique
  createdAt   DateTime    @default(now())
  recipients  Recipient[]

  @@index([companyName])
}

model Recipient {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  isAlumni        Boolean
  company         Company          @relation(fields: [companyId], references: [id])
  companyId       String
  emailLogs       EmailLog[]
  scheduledEmails ScheduledEmail[]

  @@index([email])
}

model EmailLog {
  id                   String    @id @default(uuid())
  sentAt               DateTime  @default(now())
  recipient            Recipient @relation(fields: [recipientId], references: [id])
  recipientId          String
  status               String    @default("PENDING")
  jobPosition          String
  errorMessage         String?
  templateUsed         String?
  isMarkedWrong        Boolean   @default(false)
  markedAt             DateTime?
  notes                String?
  responseReceived     Boolean   @default(false)
  responseDate         DateTime?
  responseType         String?
  followUpScheduledFor DateTime?
  followUpCount        Int       @default(0)
  lastFollowUpDate     DateTime?

  @@index([followUpScheduledFor, responseReceived])
}

model ScheduledEmail {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  scheduledFor    DateTime
  recipientId     String
  recipient       Recipient @relation(fields: [recipientId], references: [id])
  subject         String
  htmlBody        String
  jobPosition     String
  templateUsed    String
  isFollowUp      Boolean   @default(false)
  isAlum          Boolean   @default(false)
  isRecruiter     Boolean   @default(false)
  tenureYears     Int?
  personalMention String?
  status          String    @default("SCHEDULED")
  sentAt          DateTime?
  emailLogId      String?

  @@index([scheduledFor, status])
  @@index([recipientId])
}
